# Settings for docker-compose.yml. Copy to .env and fill in the values, or run
# scripts/quickstart.sh, which writes .env with random secrets. Never commit .env.

# Host port for the gateway.
ODIN_PORT=8080

# Signing secret for JWTs on services with authentication: true. Required.
# Generate one with: openssl rand -hex 32
ODIN_JWT_SECRET=

# Admin interface login (http://localhost:8080/admin). The password is required.
ODIN_ADMIN_USERNAME=admin
ODIN_ADMIN_PASSWORD=

# MongoDB root account, used by the gateway to store plugins and integration settings.
MONGO_ROOT_USERNAME=odin
MONGO_ROOT_PASSWORD=

# Gateway log level: debug, info, warn or error.
LOG_LEVEL=info

# Grafana admin password (only with `docker compose --profile observability up`).
GRAFANA_ADMIN_PASSWORD=
